{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Bus": {
    "Provider": "RabbitMQ",
    "RabbitMq": {
      "HostName": "localhost",
      "InputQueue": "person_births",
      "OutputQueue": "living_people_result"
    },
    "Redis": {
      "ConnectionString": "localhost:6379",
      "InputChannel": "person_births_channel",
      "OutputChannel": "living_people_result_channel"
    }
  },
  "Producer": {
    "Enabled": false
  }
}